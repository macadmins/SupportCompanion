    "Notification.RebootReminder" : {
      "comment" : "Notification message reminding the user to reboot their device",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Gerät wurde zuletzt vor %1$lld %2$@ neu gestartet. Bitte starten Sie Ihr Gerät neu, um optimale Leistung und Sicherheit zu gewährleisten."
          }
        },
        "en" : {
          "stringUnit" : {
